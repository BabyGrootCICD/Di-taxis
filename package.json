{
  "name": "gold-router-app",
  "version": "1.0.0",
  "description": "A non-custodial fintech application for gold-backed token trading",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "web": "node src/web/simple-server.js",
    "web-ts": "ts-node src/web/server.ts",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:pbt": "vitest --run --reporter=verbose",
    "lint": "eslint src/**/*.ts",
    "clean": "rimraf dist"
