    "eslint": "^8.0.0",
    "fast-check": "^3.23.2",
    "rimraf": "^5.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.6"
  },
  "dependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "crypto": "^1.0.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "repository": {
    "type": "git",
